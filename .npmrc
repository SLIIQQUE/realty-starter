# Payload 3.91's published peer range for `next` skips the 15.5.x line
# entirely (it jumps from "<15.5.0" straight to ">=16.3.3") even though the
# Next.js integration (admin UI, REST/GraphQL routes, withPayload) works fine
# against the 15.5.x this project pins. Without this, `npm install` fails
# with an ERESOLVE error on a peer range that is overly conservative here
# rather than a real incompatibility.
legacy-peer-deps=true

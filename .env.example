# Resend API key for the contact / valuation / newsletter forms.
# Get one at https://resend.com/api-keys — without it, forms return a clear
# "not configured" error instead of silently failing.
RESEND_API_KEY=re_xxxxxxxxxxxx

# Sender email — must be on a Resend-verified domain.
RESEND_FROM_EMAIL=SLIIQQUE <concept@send.sliiqque.space>

# Where form submissions are delivered.
RESEND_TO_EMAIL=hello@sliiqque.space

# Google Analytics 4 Measurement ID (public). Leave unset to skip loading analytics entirely.
NEXT_PUBLIC_GA_ID=

# Postgres connection string for the Payload CMS (e.g. a Neon database URL).
# Leave unset to run entirely off the static files in src/data/ — no CMS/database required.
DATABASE_URI=postgresql://user:password@host:5432/dbname

# Long random string Payload uses to sign auth tokens. Required only once DATABASE_URI is set.
PAYLOAD_SECRET=replace-with-a-long-random-string

# Google Search Console site-verification meta tag value (public). Leave unset to skip it —
# use Search Console's DNS verification method instead if you'd rather not set this.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional CRM webhook (e.g. a Zapier "Catch Hook" URL, or a Follow Up Boss / IXACT inbound
# webhook). Every successful lead (contact, valuation, viewing, listing enquiry, confirmed
# newsletter signup) is POSTed here as JSON. Leave unset to skip this — it never blocks a lead.
CRM_WEBHOOK_URL=

# Secret used to sign newsletter confirm/unsubscribe tokens (CASL double opt-in). Set this to a
# long random string before launch — without it, a hardcoded, logged dev fallback is used.
SUBSCRIBER_TOKEN_SECRET=

# Required as an `x-export-token` header to call /api/leads/export (CSV lead export). Set this to
# a long random string before launch — without it, the export endpoint rejects every request.
ADMIN_EXPORT_TOKEN=
